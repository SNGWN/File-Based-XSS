      "Use controlled callbacks and bounded navigation to prove PDFKit behavior with low user risk",
      "Only move to macOS helper or local-file handoff checks after validation payloads succeed"
    ],
    "host_context": "pdfkit_preview_viewer",
    "evidence_level": "medium",
    "recommended_validation_payloads": [
      "safari_001",
