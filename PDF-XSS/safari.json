    ],
    "default_payload_metadata": {
      "trigger": "document_open",
      "preconditions": [
        "JavaScript enabled in PDFKit-backed rendering"
      ],
      "requires_user_gesture": "no",
      "expected_signal": "webkit_bridge_or_handler_activity",
      "bug_bounty_value": "medium",
      "stability": "medium"
    },
    "total_payloads": 7,
    "categories": [
      "dom_access",
      "file_system",
      "webkit_specific",
      "macos_integration"
